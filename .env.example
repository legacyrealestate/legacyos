# Public Supabase project URL and anon key used by browser/session clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role key. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# ALMA operations assistant, call analysis, and email reply generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Server-only model for Knowledge Drop indexing. The pgvector schema expects the
# default 1536-dimension output of text-embedding-3-small.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional server-only vision-capable model used for OCR of JPG, PNG, and WebP
# Knowledge uploads. Defaults to OPENAI_MODEL when blank.
OPENAI_OCR_MODEL=
# Optional only. Core Microsoft leasing intake and templates work without AI.
AI_ASSISTANCE_ENABLED=false

# Optional legacy SMS/provider configuration. Not required for the launch Phone CRM;
# ElevenLabs is the canonical voice provider.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ElevenLabs post-call webhook signing secret. Configure:
# https://YOUR_DOMAIN/api/elevenlabs for transcription, audio, and failure events.
ELEVENLABS_WEBHOOK_SECRET=

# ElevenLabs server-side API access for historical synchronization and audio.
ELEVENLABS_API_KEY=

# Required launch agent ID pin.
ELEVENLABS_AGENT_ID=

# Optional legacy Resend receiving + sending. The launch shared inbox uses Microsoft
# 365 OAuth; configure Resend only if its separate webhook is intentionally used:
# https://YOUR_DOMAIN/api/email/webhook
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Legacy Nashville <operations@yourdomain.com>"

# off = inbox only, draft = create a provider draft for staff review. External
# email is always approval-gated; this application never auto-sends mail.
EMAIL_AUTOREPLY_MODE=draft
EMAIL_AUTOREPLY_MIN_CONFIDENCE=0.90
# Maximum automated replies per thread per hour. Defaults to 1.
EMAIL_THREAD_REPLY_RATE_LIMIT=1

# assist = suggestions only, draft = create operational drafts,
# autopilot = perform explicitly enabled routine workflows. Emergency actions stay human-reviewed.
AUTONOMY_MODE=draft

# Defaults to false unless exactly "true"; false means SMS preview only.
ENABLE_OUTBOUND_COMMUNICATIONS=false

# Public canonical app URL for server-generated Twilio callback URLs.
NEXT_PUBLIC_APP_URL=

# Comma-separated, server-only staff bootstrap allowlists.
LEGACY_ADMIN_EMAILS=
LEGACY_STAFF_EMAILS=

# OAuth application credentials and a base64-encoded 32-byte AES key.
# Microsoft scopes: openid email offline_access User.Read Mail.Read Mail.ReadWrite Mail.Send.
# Redirect: https://YOUR_DOMAIN/api/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Elevate OAuth. Create a Confidential OAuth Client in Elevate and use the exact
# authorization, token, and current-account/profile endpoints supplied by their
# developer portal. Never place these values in NEXT_PUBLIC_ variables.
# Redirect: https://YOUR_DOMAIN/api/oauth/elevate/callback
ELEVATE_OAUTH_CLIENT_ID=
ELEVATE_OAUTH_CLIENT_SECRET=
ELEVATE_OAUTH_AUTHORIZE_URL=
ELEVATE_OAUTH_TOKEN_URL=
ELEVATE_OAUTH_PROFILE_URL=
# Use the scopes specifically granted to LegacyOS in Elevate, separated by spaces.
ELEVATE_OAUTH_SCOPES="openid offline_access"
APP_ENCRYPTION_KEY=

# Protects cron-compatible synchronization routes.
CRON_SECRET=

# Maximum aggregate outbound email attachment bytes (default 10 MiB, hard cap 25 MiB).
EMAIL_ATTACHMENT_MAX_BYTES=10485760
