# Public Supabase project URL and anon key used by browser/session clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role key. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# ALMA operations assistant, call analysis, and email reply generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Server-only Twilio SMS configuration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ElevenLabs post-call webhook signing secret.
ELEVENLABS_WEBHOOK_SECRET=

# Optional ElevenLabs agent ID pin; leave blank to accept any signed post-call agent.
ELEVENLABS_AGENT_ID=

# Resend receiving + sending. Configure the receiving webhook as:
# https://YOUR_DOMAIN/api/email/webhook
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Legacy Nashville <operations@yourdomain.com>"

# off = inbox only, draft = automatically create an ALMA draft,
# send = send only routine replies; urgent/emergency/legal messages always require review.
EMAIL_AUTOREPLY_MODE=draft

# assist = suggestions only, draft = create operational drafts,
# autopilot = perform explicitly enabled routine workflows. Emergency actions stay human-reviewed.
AUTONOMY_MODE=draft

# Defaults to false unless exactly "true"; false means SMS preview only.
ENABLE_OUTBOUND_COMMUNICATIONS=false

# Public canonical app URL for server-generated Twilio callback URLs.
NEXT_PUBLIC_APP_URL=
